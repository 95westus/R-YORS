; ASM-F2 COMPACT ALU/SHIFT TABLE RUNTIME CARD.
; THE FIRST STA MUST FAIL BAD MODE WITHOUT EMITTING.
; DIRECT AND AP RUNS RETURN A=$AC, C=1, AND WRITE $AC TO $7904.

        ORG $2000
        STA #$12

START   JMP RUN

RUN     LDA #$01
        STA $40
        LDA #$03
        STA $41
        LDA #$80
        STA $42
        LDA #$40
        STA $43
        LDA #<DATA3
        STA $44
        LDA #>DATA3
        STA $45
        LDA #$03
        STA $46
        LDA #$79
        STA $47
        LDA #$02
        STA $48
        LDA #$79
        STA $49

; RESTORE MUTABLE BODY DATA SO REPEATED/RELOCATED RUNS ARE IDENTICAL.
        LDA #$0F
        STA DATA2
        LDA #$02
        STA DATA4

; ALL NINE SHARED ALU ADDRESSING ROWS, DISTRIBUTED ACROSS THE FAMILIES.
        LDA #$10
        CLC
        ADC #$05
        CMP #$15
        BNE FAIL
        SEC
        SBC $40
        CMP #$14
        BNE FAIL
        AND DATA2
        CMP #$04
        BNE FAIL
        LDX #$04
        ORA $3D,X
        CMP #$07
        BNE FAIL
        LDX #$00
        EOR DATA0,X
        CMP #$52
        BNE FAIL
        LDY #$01
        CMP DATA0,Y
        BNE FAIL
        LDX #$04
        LDA ($40,X)
        CMP #$67
        BNE FAIL
        STA ($46)
        CMP ($48),Y
        BNE FAIL

; ALL SIX SHARED SHIFT/ROTATE MODE ROWS.
        LDA #$01
        ASL
        CMP #$02
        BNE FAIL
        LDA #$04
        LSR A
        CMP #$02
        BNE FAIL
        CLC
        ROL $42
        LDA $42
        CMP #$00
        BNE FAIL
        SEC
        ROR DATA2
        LDA DATA2
        CMP #$87
        BNE FAIL
        LDX #$04
        ASL $3F,X
        LDA $43
        CMP #$80
        BNE FAIL
        LDX #$00
        LSR DATA4,X
        LDA DATA4
        CMP #$01
        BNE FAIL

PASS    LDA #$AC
        STA $7904
        SEC
        RTS

FAIL    LDA #$EE
        STA $7904
        CLC
        RTS

DATA0   DB $55,$52
DATA2   DB $0F
DATA3   DB $67
DATA4   DB $02

        ENTRY START
        END
