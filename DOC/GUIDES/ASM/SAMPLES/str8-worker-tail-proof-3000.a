; STR8-WORKER-TAIL-PROOF-3000.A
; RAM-ONLY CURRENT-WORKER UNLOCK/POLL/FAILURE PROOF.
;
; THIS FIXTURE IS PINNED TO:
;   WORKER STORE/RUN/SIZE = $FD60/$0200/$0290
;   FLASH_WRITE/WAIT/UNLOCK/RESET_FAIL =
;     $0422/$0442/$045F/$046A
;
; ASSEMBLE WITH THE CURRENT FLASH ASM, EXIT WITH '.', THEN:
;   >G 3000
;   >D 1A00 1A03
;
; TESTS:
;   1 COPY AND GUARD BYTES
;   2 SHARED POLL IMMEDIATE SUCCESS AGAINST RAM $6000
;   3 SHARED POLL TIMEOUT AND FLASH-RESET RETURN AGAINST RAM $6000
;   4 IMPOSSIBLE 0-TO-1 FLASH WRITE REJECTION WITHOUT PROGRAM COMMAND
;   5 FACTORED $AA/$55 UNLOCK FOLLOWED IMMEDIATELY BY FLASH RESET
;
; NO ERASE OR PROGRAM COMMAND IS ISSUED. THE ONLY FLASH-COMMAND WRITES ARE
; THE CASE-3/4 RESET BYTE $F0 AND THE CASE-5 UNLOCK/RESET SEQUENCE.
;
; RESULT:
;   $1A00 = $AC PASS, $E1 FAIL
;   $1A01 = LAST COMPLETED CASE, OR FAILING CASE
;   $1A02/$1A03 = BANK-3 $8000 BEFORE/AFTER
; SUCCESS RETURNS A=$AC AND C=1. FAILURE RETURNS A=$E1 AND C=0.

        ORG $3000

STATUS  EQU $1A00
CASE    EQU $1A01
BEFORE  EQU $1A02
AFTER   EQU $1A03

STORE   EQU $FD60
RUN     EQU $0200
STOREHI EQU $FD
RUNHI   EQU $02
TAIL    EQU $90

FLASH_WRITE EQU $0422
FLASH_WAIT EQU $0442
FLASH_WAIT_1 EQU $0443
FLASH_UNLOCK EQU $045F
FLASH_RESET_FAIL EQU $046A
SELECT_BANK3 EQU $0479

ADDRLO  EQU $D1
ADDRHI  EQU $D2
WDATA   EQU $D3

SPLO    EQU $A0
SPHI    EQU $A1
DPLO    EQU $A2
DPHI    EQU $A3

START   STZ STATUS
        STZ CASE
        STZ BEFORE
        STZ AFTER
        LDA #<STORE
        STA SPLO
        LDA #STOREHI
        STA SPHI
        LDA #<RUN
        STA DPLO
        LDA #RUNHI
        STA DPHI
        LDX #$02
PAGE    LDY #$00
BYTE    LDA (SPLO),Y
        STA (DPLO),Y
        INY
        BNE BYTE
        INC SPHI
        INC DPHI
        DEX
        BNE PAGE
        LDY #$00
TAILCP  CPY #TAIL
        BEQ COPIED
        LDA (SPLO),Y
        STA (DPLO),Y
        INY
        BRA TAILCP

COPIED  LDA RUN
        CMP #$08
        BEQ GUARD2
        JMP FAIL1
GUARD2  LDA $048F
        CMP #$EE
        BEQ GUARD3
        JMP FAIL1
GUARD3  LDA FLASH_WAIT
        CMP #$64
        BEQ GUARD4
        JMP FAIL1
GUARD4  LDA FLASH_WAIT_1
        CMP #$D4
        BEQ GUARDOK
        JMP FAIL1
GUARDOK LDA #$01
        STA CASE

        LDA #$5A
        STA $6000
        STZ ADDRLO
        LDA #$60
        STA ADDRHI
        LDA #$5A
        STA WDATA
        LDA #$01
        JSR FLASH_WAIT
        BCC FAIL2
        LDA $6000
        CMP #$5A
        BNE FAIL2
        LDA #$02
        STA CASE

        STZ $6000
        LDA #$5A
        STA WDATA
        LDA #$01
        JSR FLASH_WAIT
        BCS FAIL3
        CMP #$F0
        BNE FAIL3
        LDA $6000
        BNE FAIL3
        LDA #$03
        STA CASE

        JSR SELECT_BANK3
        LDA $8000
        STA BEFORE
        STZ ADDRLO
        LDA #$80
        STA ADDRHI
        LDA #$FF
        STA WDATA
        JSR FLASH_WRITE
        BCS FAIL4
        CMP #$F0
        BNE FAIL4
        LDA $8000
        STA AFTER
        CMP BEFORE
        BNE FAIL4
        LDA #$04
        STA CASE

        JSR FLASH_UNLOCK
        JSR FLASH_RESET_FAIL
        BCS FAIL5
        CMP #$F0
        BNE FAIL5
        LDA #$05
        STA CASE
        LDA #$AC
        STA STATUS
        SEC
        RTS

FAIL1   LDA #$01
        BRA FAIL
FAIL2   LDA #$02
        BRA FAIL
FAIL3   LDA #$03
        BRA FAIL
FAIL4   LDA #$04
        BRA FAIL
FAIL5   LDA #$05
FAIL    STA CASE
        LDA #$E1
        STA STATUS
        CLC
        RTS

        END
