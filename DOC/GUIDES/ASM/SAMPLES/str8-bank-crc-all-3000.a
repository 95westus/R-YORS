; STR8-BANK-CRC-ALL-3000.A
; READ-ONLY STR8 BACKUP/NO-CASCADE FINGERPRINT FIXTURE.
;
; ASSEMBLE WITH THE CURRENT FLASH ASM:
;   >ASM NEW
;   PASTE THIS COMPLETE FILE
;   ASM>$hhhh: .
;   ASM BYE
;   >G 3000
;   >D 1A00 1A04
;   >D 1A10 1A4F
;
; THE FIXTURE CALLS STR8 $F003 MODE $06 TO STAGE EVERY 4K SECTOR FROM
; EVERY PHYSICAL FLASH BANK, THEN COMPUTES CRC-16/CCITT-FALSE.
; IT NEVER ERASES OR PROGRAMS FLASH.
;
; STATUS:
;   $1A00 = $AC COMPLETE, $E1 STR8 STAGE FAILURE
;   $1A01 = FAILING BANK
;   $1A02 = FAILING SECTOR HIGH BYTE
;   $1A03/$1A04 = STR8 FAIL ADDRESS, LOW/HIGH
;   $1A08-$1A0B = BYTE $FFF0 FROM BANKS 0, 1, 2, 3
;
; CRC TABLE, LOW BYTE THEN HIGH BYTE FOR SECTORS $8 THROUGH $F:
;   $1A10-$1A1F = BANK 0
;   $1A20-$1A2F = BANK 1
;   $1A30-$1A3F = BANK 2
;   $1A40-$1A4F = BANK 3
;
; SUCCESS RETURNS A=$AC AND C=1. FAILURE RETURNS A=$E1 AND C=0.

        ORG $3000

STATUS  EQU $1A00
FAILBNK EQU $1A01
FAILSEC EQU $1A02
FAILLO  EQU $1A03
FAILHI  EQU $1A04
OLDENR  EQU $1A08
TABLE   EQU $1A10

PTRLO   EQU $A0
PTRHI   EQU $A1
CRCLO   EQU $A2
CRCHI   EQU $A3
RESLO   EQU $A4
RESHI   EQU $A5

STR8_SERVICE EQU $F003
MARK_SECTOR  EQU $1FE9
MARK_ADDR_LO EQU $1FEA
MARK_ADDR_HI EQU $1FEB
COPY_SRC     EQU $1FEE
COPY_MODE    EQU $1FF0
STAGE_BUF_HI EQU $1FF6

MODE_STAGE_BANK_SECTOR EQU $06
BUFFER_HI EQU $40

START   STZ STATUS
        STZ FAILBNK
        STZ FAILSEC
        STZ FAILLO
        STZ FAILHI
        LDA #<TABLE
        STA RESLO
        LDA #>TABLE
        STA RESHI
        STZ COPY_SRC

BANK    LDA #$80
        STA MARK_SECTOR

SECTOR LDA #BUFFER_HI
        STA STAGE_BUF_HI
        LDA #MODE_STAGE_BANK_SECTOR
        STA COPY_MODE
        JSR STR8_SERVICE
        BCC FAIL
        JSR CRC16
        LDA MARK_SECTOR
        CMP #$F0
        BNE STORE
        LDY COPY_SRC
        LDA $4FF0
        STA OLDENR,Y
STORE   LDY #$00
        LDA CRCLO
        STA (RESLO),Y
        INY
        LDA CRCHI
        STA (RESLO),Y
        LDA RESLO
        CLC
        ADC #$02
        STA RESLO
        BCC NEXT
        INC RESHI

NEXT    LDA MARK_SECTOR
        CLC
        ADC #$10
        STA MARK_SECTOR
        BNE SECTOR
        INC COPY_SRC
        LDA COPY_SRC
        CMP #$04
        BNE BANK
        LDA #$AC
        STA STATUS
        SEC
        RTS

FAIL    LDA COPY_SRC
        STA FAILBNK
        LDA MARK_SECTOR
        STA FAILSEC
        LDA MARK_ADDR_LO
        STA FAILLO
        LDA MARK_ADDR_HI
        STA FAILHI
        LDA #$E1
        STA STATUS
        CLC
        RTS

CRC16   LDA #$FF
        STA CRCLO
        STA CRCHI
        STZ PTRLO
        LDA #BUFFER_HI
        STA PTRHI
        LDX #$10

PAGE    LDY #$00
BYTE    LDA (PTRLO),Y
        JSR CRCBYTE
        INY
        BNE BYTE
        INC PTRHI
        DEX
        BNE PAGE
        RTS

CRCBYTE EOR CRCHI
        STA CRCHI
        PHX
        LDX #$08
CRCBIT  ASL CRCLO
        ROL CRCHI
        BCC BITNEXT
        LDA CRCLO
        EOR #$21
        STA CRCLO
        LDA CRCHI
        EOR #$10
        STA CRCHI
BITNEXT DEX
        BNE CRCBIT
        PLX
        RTS

        END
