; STR8N-V1.2-AP-LINK-SMOKE-2000.A
; RAM-ONLY IMPORT/RJOIN AP TEST. DOES NOT WRITE FLASH.
;
; ASM NEW
; PASTE THIS WHOLE FILE
; AT SEAL>: PACKAGE $4000
; AT SEAL>: .
; THEN: AP $4000 $3000
;
; PASS PRINTS BANK RJOIN AND RETURNS A=$AC WITH CARRY SET.
; $5848=$AC. $584A/$584B HOLD THE RESOLVED IMPORT.
; $7DC0-$7DC7 MUST SHOW THE FINAL V1.2 LINK ROW.

        ORG $2000

        IMPORT BIO_FTDI_PUT_CSTR

MAIN    BRA RUN
        ENTRY MAIN

RUN     LDX #<MSG
        LDY #>MSG
        JSR BIO_FTDI_PUT_CSTR
        LDA #<BIO_FTDI_PUT_CSTR
        STA $584A
        LDA #>BIO_FTDI_PUT_CSTR
        STA $584B
        LDA #$AC
        STA $5848
        SEC
        RTS
MSG     DB $0D,$0A,'B','A','N','K',' '
        DB 'R','J','O','I','N',$0D,$0A,0
        END
