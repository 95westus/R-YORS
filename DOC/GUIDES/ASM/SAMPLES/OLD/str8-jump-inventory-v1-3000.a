; STR8-JUMP-INVENTORY-3000.A
; ARCHIVED 2026-08-09: COMPLETED J0-J3 BOARD-INVENTORY FIXTURE.
; WHY IT WAS HERE: IT CAPTURED FULL-BANK CRC/FACE EVIDENCE BEFORE HANDOFFS.
; WHY IT MOVED: THE J0-J3 MATRIX IS HARDWARE-ACCEPTED. FOR ROUTINE INVENTORY,
; USE THE MAINTAINED STR8-BANK-CRC-ALL-3000.A READ-ONLY TOOL.
; READ-ONLY SPLIT-V1 PRE-J0-J3 BANK INVENTORY FIXTURE.
;
; ASSEMBLE WITH THE CURRENT FLASH ASM:
;   >ASM NEW
;   PASTE THIS COMPLETE FILE
;   ASM>$hhhh: .
;   ASM BYE
;   >G 3000
;   >D 1A00 1A06
;   >D 1A10 1A4F
;
; RUN ONLY FROM BANK 3. THIS FIXTURE DOES NOT CALL $F003. IT BOOTSTRAPS THE
; RAM-CALLER BANK SELECTOR THROUGH $F010, USES $0203 FOR EVERY LATER
; SELECT/RESTORE, STAGES ALL EIGHT 4K SECTORS FROM EACH BANK, COMPUTES ONE
; CRC-16/CCITT-FALSE PER 32K IMAGE, AND CAPTURES TOP-SECTOR FACE/VECTORS.
; IT NEVER ERASES OR PROGRAMS FLASH. IT REPLACES RAM $4000-$4FFF.
;
; STATUS:
;   $1A00 = $AC COMPLETE, $E1 BANK SELECT/STAGE FAILURE
;   $1A01 = FAILING BANK
;   $1A02 = FAILING SECTOR HIGH BYTE
;   $1A03/$1A04 = ZERO; NO FLASH-MUTATION FAILURE ADDRESS EXISTS
;   $1A05 = MASKED VIA PCR AFTER THE FINAL STAGE; EXPECT $EE
;   $1A06 = DECODED BANK 0-3, OR $FF IF PCR MODE IS NOT EXPLICIT
;
; FOUR 16-BYTE RECORDS:
;   $1A10-$1A1F = BANK 0
;   $1A20-$1A2F = BANK 1
;   $1A30-$1A3F = BANK 2
;   $1A40-$1A4F = BANK 3
;
; RECORD:
;   +$00/$01 = COMPLETE 32K CRC, LOW/HIGH
;   +$02-$07 = NMI, RESET, IRQ VECTORS AS $FFFA-$FFFF
;   +$08-$0B = BYTES $F000-$F003
;   +$0C-$0F = BYTES $F00C-$F00F
;
; SUCCESS RETURNS A=$AC AND C=1. FAILURE RETURNS A=$E1 AND C=0.

        ORG $3000

STATUS  EQU $1A00
FAILBNK EQU $1A01
FAILSEC EQU $1A02
FAILLO  EQU $1A03
FAILHI  EQU $1A04
PCRRAW  EQU $1A05
BANKNOW EQU $1A06
TABLE   EQU $1A10

PTRLO   EQU $A0
PTRHI   EQU $A1
CRCLO   EQU $A2
CRCHI   EQU $A3
RESLO   EQU $A4
RESHI   EQU $A5
SRCLO   EQU $A6
SRCHI   EQU $A7
DSTLO   EQU $A8
DSTHI   EQU $A9

BANK_SELECT EQU $F010
BANK_SELECT_RAM EQU $0203
MARK_SECTOR EQU $1FE9
COPY_SRC EQU $1FEE
BUFFER_HI EQU $40
VIA_PCR EQU $7FEC
PCR_MASK EQU $EE

START   STZ STATUS
        STZ FAILBNK
        STZ FAILSEC
        STZ FAILLO
        STZ FAILHI
        STZ PCRRAW
        LDA #$FF
        STA BANKNOW
        LDA #<TABLE
        STA RESLO
        LDA #>TABLE
        STA RESHI
        STZ COPY_SRC
        LDA #$80
        STA MARK_SECTOR
        LDA #$03
        JSR BANK_SELECT
        BCC FAIL

BANK    LDA #$FF
        STA CRCLO
        STA CRCHI
        LDA #$80
        STA MARK_SECTOR

SECTOR JSR STAGE
        BCC FAIL
        JSR CRC16
        LDA MARK_SECTOR
        CMP #$F0
        BNE NEXT
        JSR STORE

NEXT    LDA MARK_SECTOR
        CLC
        ADC #$10
        STA MARK_SECTOR
        BNE SECTOR
        LDA RESLO
        CLC
        ADC #$10
        STA RESLO
        BCC NEXTBANK
        INC RESHI
NEXTBANK INC COPY_SRC
        LDA COPY_SRC
        CMP #$04
        BNE BANK
        LDA VIA_PCR
        AND #PCR_MASK
        STA PCRRAW
        JSR DECODE
        STA BANKNOW
        LDA #$AC
        STA STATUS
        SEC
        RTS

FAIL    LDA COPY_SRC
        STA FAILBNK
        LDA MARK_SECTOR
        STA FAILSEC
        LDA VIA_PCR
        AND #PCR_MASK
        STA PCRRAW
        JSR DECODE
        STA BANKNOW
        LDA #$E1
        STA STATUS
        CLC
        RTS

STAGE   PHP
        SEI
        LDA COPY_SRC
        JSR BANK_SELECT_RAM
        BCC STAGEFAIL
        STZ SRCLO
        LDA MARK_SECTOR
        STA SRCHI
        STZ DSTLO
        LDA #BUFFER_HI
        STA DSTHI
        LDX #$10
STPAGE  LDY #$00
STBYTE  LDA (SRCLO),Y
        STA (DSTLO),Y
        INY
        BNE STBYTE
        INC SRCHI
        INC DSTHI
        DEX
        BNE STPAGE
        LDA #$03
        JSR BANK_SELECT_RAM
        BCC STAGEFAIL
        PLP
        SEC
        RTS
STAGEFAIL LDA #$03
        JSR BANK_SELECT_RAM
        PLP
        CLC
        RTS

STORE   LDY #$00
        LDA CRCLO
        STA (RESLO),Y
        INY
        LDA CRCHI
        STA (RESLO),Y
        INY
        LDA $4FFA
        STA (RESLO),Y
        INY
        LDA $4FFB
        STA (RESLO),Y
        INY
        LDA $4FFC
        STA (RESLO),Y
        INY
        LDA $4FFD
        STA (RESLO),Y
        INY
        LDA $4FFE
        STA (RESLO),Y
        INY
        LDA $4FFF
        STA (RESLO),Y
        INY
        LDA $4000
        STA (RESLO),Y
        INY
        LDA $4001
        STA (RESLO),Y
        INY
        LDA $4002
        STA (RESLO),Y
        INY
        LDA $4003
        STA (RESLO),Y
        INY
        LDA $400C
        STA (RESLO),Y
        INY
        LDA $400D
        STA (RESLO),Y
        INY
        LDA $400E
        STA (RESLO),Y
        INY
        LDA $400F
        STA (RESLO),Y
        RTS

DECODE  LDA PCRRAW
        LDX #$00
DECLOOP CMP BANKBITS,X
        BEQ DECOK
        INX
        CPX #$04
        BNE DECLOOP
        LDA #$FF
        CLC
        RTS
DECOK   TXA
        SEC
        RTS

CRC16   STZ PTRLO
        LDA #BUFFER_HI
        STA PTRHI
        LDX #$10

PAGE    LDY #$00
BYTE    LDA (PTRLO),Y
        JSR CRCBYTE
        INY
        BNE BYTE
        INC PTRHI
        DEX
        BNE PAGE
        RTS

CRCBYTE EOR CRCHI
        STA CRCHI
        PHX
        LDX #$08
CRCBIT  ASL CRCLO
        ROL CRCHI
        BCC BITNEXT
        LDA CRCLO
        EOR #$21
        STA CRCLO
        LDA CRCHI
        EOR #$10
        STA CRCHI
BITNEXT DEX
        BNE CRCBIT
        PLX
        RTS

BANKBITS DB $CC,$CE,$EC,$EE

        END
