; BANK-DUMP-2000.A
; READ-ONLY FIXED-$2000 APC FOR PHYSICAL FLASH INSPECTION.
;
; ASM NEW
; PASTE THIS WHOLE FILE
; AT SEAL>: PACKAGE BANKDUMP $3000
; AT SEAL>: INSTALL 3000 B2
; AFTER RESET: AP B2 BANKDUMP
;
; H DECODES AN AP-V2 HEADER AND DUMPS ITS FIRST 256 BYTES.
; P DUMPS ONE SELECTED 256-BYTE PAGE. A DUMPS ALL 4K.
; THE FLASH SECTOR IS STAGED AT $4000 BEFORE DISPLAY.
; BANK 3 IS RESTORED BEFORE ANY DUMP OUTPUT. NO FLASH WRITES.

ORG $2000

IMPORT BIO_FTDI_PUT_CSTR
IMPORT SYS_READ_CSTRING_ECHO_UPPER
IMPORT BIO_FTDI_WRITE_BYTE_BLOCK

STATUS EQU $7C00
BANK_NO EQU $7C01
SECTOR_HI EQU $7C02
MODE EQU $7C03
PAGE_NO EQU $7C04
PAGES_LEFT EQU $7C05
ROWS_LEFT EQU $7C06
CRC_LO_RESULT EQU $7C08
CRC_HI_RESULT EQU $7C09
INPUT EQU $7000
PTR_LO EQU $A0
PTR_HI EQU $A1
SRC_LO EQU $A2
SRC_HI EQU $A3
DST_LO EQU $A4
DST_HI EQU $A5
CRC_LO EQU $A6
CRC_HI EQU $A7
ADDR_LO EQU $A8
ADDR_HI EQU $A9
BANK_SELECT EQU $F010
BANK_SELECT_RAM EQU $0203
BUFFER_HI EQU $40

; BEGIN SHARED BANKDUMP BODY
BANKDUMP BRA RUN
ENTRY BANKDUMP
RUN STZ STATUS
LDX #$8F
LDY #$23
JSR $2382
ASK_BANK LDX #$A6
LDY #$23
JSR $2382
JSR $2135
BCS BANK_READ_OK
JMP $2127
BANK_READ_OK CMP #'0'
BCS BANK_LOW_OK
JMP $20FB
BANK_LOW_OK CMP #'4'
BCC BANK_VALUE_OK
JMP $20FB
BANK_VALUE_OK SEC
SBC #'0'
STA BANK_NO
ASK_SECTOR LDX #$B1
LDY #$23
JSR $2382
JSR $2135
BCS SECTOR_READ_OK
JMP $2127
SECTOR_READ_OK JSR $214D
BCS SECTOR_HEX_OK
JMP $2105
SECTOR_HEX_OK CMP #$08
BCS SECTOR_VALUE_OK
JMP $2105
SECTOR_VALUE_OK ASL A
ASL A
ASL A
ASL A
STA SECTOR_HI
ASK_MODE LDX #$BE
LDY #$23
JSR $2382
JSR $2135
BCS MODE_READ_OK
JMP $2127
MODE_READ_OK CMP #'Q'
BNE MODE_NOT_QUIT
JMP $2127
MODE_NOT_QUIT CMP #'H'
BEQ MODE_OK
CMP #'P'
BEQ MODE_PAGE
CMP #'A'
BEQ MODE_OK
BAD_MODE LDX #$08
LDY #$24
JSR $2382
BRA ASK_MODE
MODE_PAGE STA MODE
ASK_PAGE LDX #$E1
LDY #$23
JSR $2382
JSR $2135
BCS PAGE_READ_OK
JMP $2127
PAGE_READ_OK JSR $214D
BCC BAD_PAGE
STA PAGE_NO
BRA CONFIGURED
MODE_OK STA MODE
STZ PAGE_NO
CONFIGURED JSR $2168
BCC STAGE_FAIL
JSR $21AA
JSR $21EC
LDA MODE
CMP #'H'
BNE NOT_HEADER
JSR $2222
LDA #$01
STA PAGES_LEFT
BRA DUMP_PAGE
NOT_HEADER CMP #'P'
BNE ALL_PAGES
LDA #$01
STA PAGES_LEFT
BRA DUMP_PAGE
ALL_PAGES LDA #$10
STA PAGES_LEFT
DUMP_PAGE JSR $22E5
DEC PAGES_LEFT
BEQ COMPLETE
LDX #$90
LDY #$24
JSR $2382
JSR $2146
BCC ABORT
LDA INPUT
CMP #'Q'
BEQ ABORT
INC PAGE_NO
BRA DUMP_PAGE
COMPLETE LDX #$B1
LDY #$24
JSR $2382
LDA #$AC
STA STATUS
SEC
RTS
BAD_BANK LDX #$EC
LDY #$23
JSR $2382
JMP $200C
BAD_SECTOR LDX #$F9
LDY #$23
JSR $2382
JMP $202F
BAD_PAGE LDX #$17
LDY #$24
JSR $2382
JMP $2082
STAGE_FAIL LDX #$CE
LDY #$24
JSR $2382
LDA #$E1
STA STATUS
CLC
RTS
ABORT LDX #$F4
LDY #$24
JSR $2382
LDA #$E0
STA STATUS
CLC
RTS
READ_ONE JSR $2146
BCC READ_ONE_FAIL
LDA INPUT+1
BNE READ_ONE_FAIL
LDA INPUT
SEC
RTS
READ_ONE_FAIL CLC
RTS
READ_LINE LDX #$00
LDY #$70
JMP SYS_READ_CSTRING_ECHO_UPPER
HEX_VALUE CMP #'0'
BCC HEX_VALUE_BAD
CMP #':'
BCC HEX_VALUE_DIGIT
CMP #'A'
BCC HEX_VALUE_BAD
CMP #'G'
BCS HEX_VALUE_BAD
SEC
SBC #$37
SEC
RTS
HEX_VALUE_DIGIT AND #$0F
SEC
RTS
HEX_VALUE_BAD CLC
RTS
STAGE PHP
SEI
LDA #$03
JSR $F010
BCC STAGE_BAD
LDA BANK_NO
JSR $0203
BCC STAGE_BAD
STZ SRC_LO
LDA SECTOR_HI
STA SRC_HI
STZ DST_LO
LDA #BUFFER_HI
STA DST_HI
LDX #$10
STAGE_PAGE LDY #$00
STAGE_BYTE LDA (SRC_LO),Y
STA (DST_LO),Y
INY
BNE STAGE_BYTE
INC SRC_HI
INC DST_HI
DEX
BNE STAGE_PAGE
LDA #$03
JSR $0203
BCC STAGE_BAD
PLP
SEC
RTS
STAGE_BAD LDA #$03
JSR $0203
PLP
CLC
RTS
CRC16 LDA #$FF
STA CRC_LO
STA CRC_HI
STZ PTR_LO
LDA #BUFFER_HI
STA PTR_HI
LDX #$10
CRC_PAGE LDY #$00
CRC_BYTE LDA (PTR_LO),Y
EOR CRC_HI
STA CRC_HI
PHX
LDX #$08
CRC_BIT ASL CRC_LO
ROL CRC_HI
BCC CRC_NEXT
LDA CRC_LO
EOR #$21
STA CRC_LO
LDA CRC_HI
EOR #$10
STA CRC_HI
CRC_NEXT DEX
BNE CRC_BIT
PLX
INY
BNE CRC_BYTE
INC PTR_HI
DEX
BNE CRC_PAGE
LDA CRC_LO
STA CRC_LO_RESULT
LDA CRC_HI
STA CRC_HI_RESULT
RTS
PRINT_SELECTION LDX #$24
LDY #$24
JSR $2382
LDA BANK_NO
CLC
ADC #'0'
JSR $237F
LDA #':'
JSR $237F
LDA SECTOR_HI
JSR $2367
LDA #$00
JSR $2367
LDX #$31
LDY #$24
JSR $2382
LDA CRC_HI_RESULT
JSR $2367
LDA CRC_LO_RESULT
JSR $2367
JMP $2385
PRINT_AP_HEADER LDA $4000
CMP #'A'
BEQ AP_SIG0_OK
JMP $22D7
AP_SIG0_OK LDA $4001
CMP #'P'
BEQ AP_SIG1_OK
JMP $22D7
AP_SIG1_OK LDA $4002
CMP #$02
BEQ AP_VERSION_OK
JMP $22D7
AP_VERSION_OK LDA $4005
CMP #'S'
BEQ AP_SEAL_OK
JMP $22DE
AP_SEAL_OK LDA $4006
CMP #$0B
BEQ AP_SEAL_LEN_OK
JMP $22DE
AP_SEAL_LEN_OK LDA $4007
BEQ AP_SHAPE_OK
JMP $22DE
AP_SHAPE_OK LDX #$39
LDY #$24
JSR $2382
LDA $4002
JSR $2367
LDX #$40
LDY #$24
JSR $2382
LDA $4004
JSR $2367
LDA $4003
JSR $2367
LDX #$46
LDY #$24
JSR $2382
LDA $400A
JSR $2367
LDA $4009
JSR $2367
LDX #$4D
LDY #$24
JSR $2382
LDA $400C
JSR $2367
LDA $400B
JSR $2367
LDX #$53
LDY #$24
JSR $2382
LDA $400E
JSR $2367
LDA $400D
JSR $2367
LDX #$5A
LDY #$24
JSR $2382
LDA $4012
JSR $2367
LDA $4011
JSR $2367
LDA $4010
JSR $2367
LDA $400F
JSR $2367
JMP $2385
AP_NOT_V2 LDX #$60
LDY #$24
JMP $2382
AP_BAD_SHAPE LDX #$78
LDY #$24
JMP $2382
DUMP_256 STZ PTR_LO
LDA PAGE_NO
CLC
ADC #BUFFER_HI
STA PTR_HI
STZ ADDR_LO
LDA PAGE_NO
CLC
ADC SECTOR_HI
STA ADDR_HI
LDA #$10
STA ROWS_LEFT
DUMP_ROW JSR $2385
LDA ADDR_HI
JSR $2367
LDA ADDR_LO
JSR $2367
LDA #':'
JSR $237F
LDA #' '
JSR $237F
LDY #$00
DUMP_HEX LDA (PTR_LO),Y
JSR $2367
LDA #' '
JSR $237F
INY
CPY #$10
BNE DUMP_HEX
LDA #'|'
JSR $237F
LDY #$00
DUMP_ASCII LDA (PTR_LO),Y
CMP #$20
BCC DUMP_DOT
CMP #$7F
BCS DUMP_DOT
BRA DUMP_CHAR
DUMP_DOT LDA #'.'
DUMP_CHAR JSR $237F
INY
CPY #$10
BNE DUMP_ASCII
LDA #'|'
JSR $237F
LDA PTR_LO
CLC
ADC #$10
STA PTR_LO
BCC DUMP_ADDR
INC PTR_HI
DUMP_ADDR LDA ADDR_LO
CLC
ADC #$10
STA ADDR_LO
BCC DUMP_NEXT
INC ADDR_HI
DUMP_NEXT DEC ROWS_LEFT
BNE DUMP_ROW
JMP $2385
HEX_BYTE PHA
LSR A
LSR A
LSR A
LSR A
JSR $2372
PLA
AND #$0F
HEX_NIBBLE CMP #$0A
BCC HEX_DIGIT
CLC
ADC #$37
JMP $237F
HEX_DIGIT CLC
ADC #'0'
PUTC JMP BIO_FTDI_WRITE_BYTE_BLOCK
PUTS JMP BIO_FTDI_PUT_CSTR
CRLF LDA #$0D
JSR $237F
LDA #$0A
JMP $237F
MSG_TITLE DB $0D,$0A,'B','A','N','K','D','U','M','P'
DB ' ','R','E','A','D','-','O','N','L','Y',$0D,$0A,0
MSG_BANK DB 'B','A','N','K',' ','0','-','3','>',' ',0
MSG_SECTOR DB 'S','E','C','T','O','R',' ','8','-','F','>',' ',0
MSG_MODE DB 'H','=','A','P','C',' ','H','E','A','D','E','R',' '
DB 'P','=','P','A','G','E',' ','A','=','A','L','L',' '
DB 'Q','=','Q','U','I','T','>',' ',0
MSG_PAGE DB 'P','A','G','E',' ','0','-','F','>',' ',0
MSG_BAD_BANK DB '?',' ','B','A','N','K',' ','0','-','3'
DB $0D,$0A,0
MSG_BAD_SECTOR DB '?',' ','S','E','C','T','O','R'
DB ' ','8','-','F',$0D,$0A,0
MSG_BAD_MODE DB '?',' ','H',',','P',',','A'
DB ' ','O','R',' ','Q',$0D,$0A,0
MSG_BAD_PAGE DB '?',' ','P','A','G','E',' ','0','-','F'
DB $0D,$0A,0
MSG_SELECTED DB $0D,$0A,'B','A','N','K','D','U','M','P'
DB ' ','B',0
MSG_CRC DB ' ','C','R','C','1','6','=',0
MSG_APC DB 'A','P','C',' ','V','=',0
MSG_PKG DB ' ','P','K','G','=',0
MSG_BASE DB ' ','B','A','S','E','=',0
MSG_END DB ' ','E','N','D','=',0
MSG_BODY DB ' ','B','O','D','Y','=',0
MSG_FNV DB ' ','F','N','V','=',0
MSG_NOT_AP DB 'A','P','C',' ','H','E','A','D','E','R',':'
DB ' ','N','O','T',' ','A','P',' ','V','2',$0D,$0A,0
MSG_BAD_AP DB 'A','P','C',' ','H','E','A','D','E','R',':'
DB ' ','B','A','D',' ','S','H','A','P','E',$0D,$0A,0
MSG_MORE DB $0D,$0A,'-','-',' ','M','O','R','E',' '
DB '(','E','N','T','E','R','=','N','E','X','T',','
DB ' ','Q','=','Q','U','I','T',')','>',' ',0
MSG_OK DB $0D,$0A,'B','A','N','K','D','U','M','P'
DB ' ','O','K',$3B,' ','B','3',' '
DB 'R','E','S','T','O','R','E','D',$0D,$0A,0
MSG_STAGE_FAIL DB $0D,$0A,'B','A','N','K','D','U','M','P'
DB ' ','E','1',$3B,' ','B','3',' '
DB 'R','E','S','T','O','R','E',' '
DB 'A','T','T','E','M','P','T','E','D',$0D,$0A,0
MSG_ABORT DB $0D,$0A,'B','A','N','K','D','U','M','P'
DB ' ','Q','U','I','T',$3B,' ','N','O',' '
DB 'F','L','A','S','H',' '
DB 'W','R','I','T','E',$0D,$0A,0
; END SHARED BANKDUMP BODY

END
