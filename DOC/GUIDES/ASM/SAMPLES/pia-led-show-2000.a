; PIA-LED-SHOW-2000.A
; MOVABLE AP DEMO FOR THE EIGHT EDU LEDS ON PIA PORT A.
;
; ASM NEW
; PASTE THIS WHOLE FILE
; AT SEAL>: SEAL
; AT SEAL>: PACKAGE PIALED $3000
; AT SEAL>: INSTALL 3000 B1
; AT SEAL>: .
; RESET; THEN AT HIMON: APS B1
; RUN THE NAMED CARRIER: AP B1 PIALED
;
; APMAN CHOOSES THE FIRST SAFE ERASED B1 SECTOR. THE PACKAGE SEALED BASE IS
; $2000, SO AP B1 PIALED LOADS/FIXES THERE AND RUNS WITHOUT A FOLLOWING G.
;
; THE PROGRAM RUNS FOR ABOUT THREE SECONDS AT 8 MHZ. IT WALKS THE FIRST
; FOUR LEDS, THEN THE OTHER FOUR, SHOWS ALTERNATING PATTERNS, AND RESTORES
; THE PREVIOUS PORT-A OUTPUT AND DIRECTION BEFORE RETURNING A=$AC/C=1.

        ORG $2000

; W65C21 $7FA0 SELECTS DDRA WHEN CRA BIT 2 IS CLEAR, PORT A WHEN SET.
PIA_PORTA_DDRA EQU $7FA0
PIA_CRA EQU $7FA1

; BEGIN SHARED LED BODY
PIALED  BRA RUN
        ENTRY PIALED

RUN     LDA PIA_CRA
        PHA
        ORA #$04
        STA PIA_CRA
        LDA PIA_PORTA_DDRA
        PHA
        LDA PIA_CRA
        AND #$FB
        STA PIA_CRA
        LDA PIA_PORTA_DDRA
        PHA
        LDA #$FF
        STA PIA_PORTA_DDRA
        LDA PIA_CRA
        ORA #$04
        STA PIA_CRA
        LDX #$00

NEXT    LDA PATTERNS,X
        JSR SHOW
        INX
        CPX #$10
        BNE NEXT

        LDA PIA_CRA
        AND #$FB
        STA PIA_CRA
        PLA
        STA PIA_PORTA_DDRA
        LDA PIA_CRA
        ORA #$04
        STA PIA_CRA
        PLA
        STA PIA_PORTA_DDRA
        PLA
        STA PIA_CRA
        LDA #$AC
        SEC
        RTS

SHOW    STA PIA_PORTA_DDRA
        JSR DELAY40
        JSR DELAY40
        JSR DELAY40
        JSR DELAY40
        RTS

DELAY40 PHX
        PHY
        LDX #$00
DLY1    LDY #$00
DLY2    DEY
        BNE DLY2
        DEX
        BNE DLY1
        PLY
        PLX
        RTS

PATTERNS DB $01,$02,$04,$08,$0F,$00,$10,$20
        DB $40,$80,$F0,$00,$55,$AA,$FF,$00
; END SHARED LED BODY

        END
