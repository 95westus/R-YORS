; PIA-LED-SHOW-2000.A
; MOVABLE AP DEMO FOR THE EIGHT EDU LEDS ON PIA PORT A.
;
; ASM NEW
; PASTE THIS WHOLE FILE
; AT SEAL>: SEAL
; AT SEAL>: PACKAGE $3000
; AT SEAL>: .
;
; THE PROGRAM RUNS FOR ABOUT THREE SECONDS AT 8 MHZ. IT WALKS THE FIRST
; FOUR LEDS, THEN THE OTHER FOUR, SHOWS ALTERNATING PATTERNS, AND RESTORES
; THE PREVIOUS PORT-A OUTPUT AND DIRECTION BEFORE RETURNING A=$AC/C=1.

        ORG $2000

PIA_PORTA EQU $7FA1
PIA_DDRA EQU $7FA3

; BEGIN SHARED LED BODY
MAIN    BRA RUN
        ENTRY MAIN

RUN     LDA PIA_DDRA
        PHA
        LDA PIA_PORTA
        PHA
        LDA #$FF
        STA PIA_DDRA
        LDX #$00

NEXT    LDA PATTERNS,X
        JSR SHOW
        INX
        CPX #$10
        BNE NEXT

        PLA
        STA PIA_PORTA
        PLA
        STA PIA_DDRA
        LDA #$AC
        SEC
        RTS

SHOW    STA PIA_PORTA
        JSR DELAY40
        JSR DELAY40
        JSR DELAY40
        JSR DELAY40
        RTS

DELAY40 PHX
        PHY
        LDX #$00
DLY1    LDY #$00
DLY2    DEY
        BNE DLY2
        DEX
        BNE DLY1
        PLY
        PLX
        RTS

PATTERNS DB $01,$02,$04,$08,$0F,$00,$10,$20
        DB $40,$80,$F0,$00,$55,$AA,$FF,$00
; END SHARED LED BODY

        END
