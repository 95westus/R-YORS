   191 00:5131: C8                                   INY
   192 00:5132: D0 FB                                BNE             ?STAGE_BYTE
   193 00:5134: E6 A3                                INC             $A3
   194 00:5136: CA                                   DEX
   195 00:5137: D0 F2                                BNE             ?STAGE_PAGE
   196 00:5139: A2 0F                                LDX             #(HANDOFF_STATE_END-HANDOFF_STATE-1)
   197 00:513B: 9E 00 54     ?STATE:                 STZ             HANDOFF_STATE,X
   198 00:513E: CA                                   DEX
   199 00:513F: 10 FA                                BPL             ?STATE
