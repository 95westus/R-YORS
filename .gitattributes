# Auto detect text files and perform LF normalization
* text=auto

# Firmware/programmer images must remain byte-for-byte exact.
*.bin binary
*.BIN binary

# Release checksums cover exact bytes on every checkout platform.
RELEASE/*.zip binary
RELEASE/README.md -text whitespace=cr-at-eol
RELEASE/SHA256SUMS.txt -text whitespace=cr-at-eol
RELEASE/QUALIFICATION.json -text whitespace=cr-at-eol
RELEASE/component-release-manifest.json -text whitespace=cr-at-eol
RELEASE/release-index.json -text whitespace=cr-at-eol
RELEASE/ryors-v1.2-himon-asm-bank3-8-e.s19 -text whitespace=cr-at-eol

# Preserve the original bytes referenced by the new hardware proof hashes.
DOC/GUIDES/LOGS/ASMF2_SIZE_2026-09-15.jsonl -text whitespace=cr-at-eol
DOC/GUIDES/LOGS/HIMON_SIZE_2026-09-15.jsonl -text whitespace=cr-at-eol
DOC/GUIDES/LOGS/HIMON_RESTAMP_2026-09-15.jsonl -text whitespace=cr-at-eol

# Frozen AP qualification receipts retain the exact bytes in their manifests.
# Archived patches/logs can contain intentional whitespace; do not normalize it.
DOC/GUIDES/LOGS/HIMON_AP_*_2026-09-16/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
DOC/GUIDES/LOGS/APMAN_SIZE_2026-09-16/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
DOC/GUIDES/LOGS/RAM_AP_HANDOFF_2026-09-16/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
DOC/GUIDES/LOGS/AM03_BOARD_2026-09-16/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
DOC/GUIDES/LOGS/STR8N_V135_BOARD_2026-09-16/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
DOC/GUIDES/LOGS/HIMON_AP_*_2026-09-16.jsonl -text whitespace=cr-at-eol
DOC/GUIDES/LOGS/BSO2_B2_INSTALL_*.jsonl -text whitespace=cr-at-eol
