; ASM v1 direct-relocation boundary: 1 JMP + 9*7 DW = 64 rows.
; RUN=$0081; the relocated proof writes $64 to $7100.

ORG $2000
JMP RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
RUN LDA #$64
STA $7100
RTS
END
