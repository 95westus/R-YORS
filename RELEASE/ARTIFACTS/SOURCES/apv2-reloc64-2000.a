; APV2 64-RELOCATION RAM-ONLY BOARD CARD.
; PACKAGE AT $3200, THEN USE HIMON AP $3200 $3000.
; PASS WRITES $64 TO $7900 AND RETURNS A=$64 WITH CARRY SET.
; RUN OFFSET=$0081; AP V2 R PAYLOAD MUST BE $0141.

ORG $2000
START JMP RUN
ENTRY START
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
RUN LDA #$64
STA $7900
SEC
RTS
END
