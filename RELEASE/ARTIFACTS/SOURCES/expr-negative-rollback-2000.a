; ASM-F2 EXPRESSION REJECTION/ROLLBACK CARD.
; EVERY REJECTED LINE MUST LEAVE PC=$2001.
; FINAL BYTES MUST BE $A5,$5A WITH TWO SYMBOLS AND ZERO FIXUPS.

        ORG $2000
BASE    DB $A5

        LDA #1<<16
        LDA #1<2
        LDA #2/1
        LDA #2*3
        LDA #$F0&$1234
        LDA MISSING+1

TAIL    DB $5A
        END
