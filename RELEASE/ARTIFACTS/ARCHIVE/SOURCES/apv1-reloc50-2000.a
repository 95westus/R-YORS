; AP v1 relocation boundary: 1 JMP + 7*7 DW = 50 rows.
; RUN=$0065; the loaded proof writes $5A to $7100.

ORG $2000
JMP RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
DW RUN,RUN,RUN,RUN,RUN,RUN,RUN
RUN LDA #$5A
STA $7100
RTS
END
