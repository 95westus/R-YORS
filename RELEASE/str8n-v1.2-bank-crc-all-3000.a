; STR8N-V1.2-BANK-CRC-ALL-3000.A
; READ-ONLY SPLIT-V1 FOUR-BANK CRC/NO-WRITE ORACLE.
;
; ASSEMBLE WITH THE CURRENT FLASH ASM:
;   >ASM NEW
;   PASTE THIS COMPLETE FILE
;   ASM>$hhhh: .
;   ASM BYE
;   >G 3000
;   >D 1A00 1A04
;   >D 1A10 1A4F
;
; THIS FIXTURE DOES NOT CALL $F003. IT BOOTSTRAPS THE RAM-CALLER BANK
; SELECTOR THROUGH $F010, USES THE COPIED $0203 ENTRY FOR EVERY LATER
; SELECT/RESTORE, STAGES EACH 4K SECTOR AT $4000-$4FFF, AND COMPUTES
; CRC-16/CCITT-FALSE. IT NEVER ERASES OR PROGRAMS FLASH.
;
; STATUS:
;   $7C00 = $AC COMPLETE, $E1 BANK SELECT/STAGE FAILURE
;   $7C01 = FAILING BANK
;   $7C02 = FAILING SECTOR HIGH BYTE
;   $7C03/$7C04 = ZERO; NO FLASH-MUTATION FAILURE ADDRESS EXISTS
;   $7C08-$7C0B = BYTE $FFF0 FROM BANKS 0, 1, 2, 3
;
; CRC TABLE, LOW BYTE THEN HIGH BYTE FOR SECTORS $8 THROUGH $F:
;   $7C10-$7C1F = BANK 0
;   $7C20-$7C2F = BANK 1
;   $7C30-$7C3F = BANK 2
;   $7C40-$7C4F = BANK 3
;
; SUCCESS RETURNS A=$AC AND C=1. FAILURE RETURNS A=$E1 AND C=0.

        ORG $3000

STATUS  EQU $7C00
FAILBNK EQU $7C01
FAILSEC EQU $7C02
FAILLO  EQU $7C03
FAILHI  EQU $7C04
OLDENR  EQU $7C08
TABLE   EQU $7C10

PTRLO   EQU $A0
PTRHI   EQU $A1
CRCLO   EQU $A2
CRCHI   EQU $A3
RESLO   EQU $A4
RESHI   EQU $A5
SRCLO   EQU $A6
SRCHI   EQU $A7
DSTLO   EQU $A8
DSTHI   EQU $A9

BANK_SELECT EQU $F010
BANK_SELECT_RAM EQU $0203
MARK_SECTOR EQU $7DE9
COPY_SRC EQU $7DEE
BUFFER_HI EQU $40

START   STZ STATUS
        STZ FAILBNK
        STZ FAILSEC
        STZ FAILLO
        STZ FAILHI
        LDA #<TABLE
        STA RESLO
        LDA #>TABLE
        STA RESHI
        STZ COPY_SRC
        LDA #$80
        STA MARK_SECTOR
        LDA #$03
        JSR BANK_SELECT
        BCC FAIL

BANK    LDA #$80
        STA MARK_SECTOR

SECTOR JSR STAGE
        BCC FAIL
        JSR CRC16
        LDA MARK_SECTOR
        CMP #$F0
        BNE STORE
        LDY COPY_SRC
        LDA $4FF0
        STA OLDENR,Y
STORE   LDY #$00
        LDA CRCLO
        STA (RESLO),Y
        INY
        LDA CRCHI
        STA (RESLO),Y
        LDA RESLO
        CLC
        ADC #$02
        STA RESLO
        BCC NEXT
        INC RESHI

NEXT    LDA MARK_SECTOR
        CLC
        ADC #$10
        STA MARK_SECTOR
        BNE SECTOR
        INC COPY_SRC
        LDA COPY_SRC
        CMP #$04
        BNE BANK
        LDA #$AC
        STA STATUS
        SEC
        RTS

FAIL    LDA COPY_SRC
        STA FAILBNK
        LDA MARK_SECTOR
        STA FAILSEC
        LDA #$E1
        STA STATUS
        CLC
        RTS

STAGE   PHP
        SEI
        LDA COPY_SRC
        JSR BANK_SELECT_RAM
        BCC STAGEFAIL
        STZ SRCLO
        LDA MARK_SECTOR
        STA SRCHI
        STZ DSTLO
        LDA #BUFFER_HI
        STA DSTHI
        LDX #$10
STPAGE  LDY #$00
STBYTE  LDA (SRCLO),Y
        STA (DSTLO),Y
        INY
        BNE STBYTE
        INC SRCHI
        INC DSTHI
        DEX
        BNE STPAGE
        LDA #$03
        JSR BANK_SELECT_RAM
        BCC STAGEFAIL
        PLP
        SEC
        RTS
STAGEFAIL LDA #$03
        JSR BANK_SELECT_RAM
        PLP
        CLC
        RTS

CRC16   LDA #$FF
        STA CRCLO
        STA CRCHI
        STZ PTRLO
        LDA #BUFFER_HI
        STA PTRHI
        LDX #$10

PAGE    LDY #$00
BYTE    LDA (PTRLO),Y
        JSR CRCBYTE
        INY
        BNE BYTE
        INC PTRHI
        DEX
        BNE PAGE
        RTS

CRCBYTE EOR CRCHI
        STA CRCHI
        PHX
        LDX #$08
CRCBIT  ASL CRCLO
        ROL CRCHI
        BCC BITNEXT
        LDA CRCLO
        EOR #$21
        STA CRCLO
        LDA CRCHI
        EOR #$10
        STA CRCHI
BITNEXT DEX
        BNE CRCBIT
        PLX
        RTS

        END
