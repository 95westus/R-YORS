DOC/s34 
.tmp_test.py

# Firmware images are generated by default. Only the flat RELEASE directory
# retains current product files in Git.
*.[bB][iI][nN]
*.[sS]19

# Generated documentation presentation. Markdown is canonical.
/DOC/HTML/
/index.html

# Local third-party / provenance-preserving source homes.
# These are intentionally usable by the build but not tracked here.
/LOCAL/
/SRC/TEST/apps/*.BAS
/SRC/TEST/apps/fig-forth.asm
/SRC/TEST/apps/msbasic/

# Compiler output and timestamped ROM snapshots stay disposable. RELEASE is
# the sole operator-facing, tracked publication directory.
/BUILD/
/SRC/BUILD/
/SRC/ROM_IMAGES/
/RELEASE/**
!/RELEASE/
!/RELEASE/*.md
!/RELEASE/*.txt
!/RELEASE/*.[aA]
!/RELEASE/*.[aA][sS][mM]
!/RELEASE/*.[bB][iI][nN]
!/RELEASE/*.[sS]19
!/RELEASE/*.json

# WDCMONv2 images are local/provenance-only, including under RELEASE. Keep
# these after the RELEASE allowlist so they cannot be published accidentally.
*[wW][dD][cC][mM][oO][nN][vV]2*.[bB][iI][nN]
*[wW][dD][cC][mM][oO][nN][vV]2*.[sS]19

# Immutable console-input fixture referenced by hardware proof. This is test
# source, not a generated firmware artifact.
